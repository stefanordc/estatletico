# Reinicie npm start ou execute npm run build depois de alterar.
DATA_SOURCE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=estatletico
MYSQL_USER=root
MYSQL_PASSWORD=
PORT=8000
# Vazio: frontend e API na mesma origem (recomendado).
PUBLIC_API_URL=
# Senha LOCAL independente do Supabase (mínimo 12 caracteres).
LOCAL_ADMIN_PASSWORD=
# Preserve as credenciais existentes. URL/chave anon existentes em app.js
# continuam sendo o fallback do modo Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Conexão PostgreSQL direta ou Session pooler, usada SOMENTE pelos scripts.
SUPABASE_DB_URL=
# Opcional: caminho do certificado raiz fornecido pelo Supabase.
SUPABASE_SSL_CA=
MIGRATION_BATCH_SIZE=100
