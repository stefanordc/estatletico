{
  "name": "estatletico",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server/index.cjs",
    "build": "node scripts/build.cjs",
    "db:create": "node scripts/create-mysql.cjs",
    "db:inspect": "node scripts/copy-supabase-to-mysql.cjs --inspect",
    "db:copy": "node scripts/copy-supabase-to-mysql.cjs",
    "db:verify": "node scripts/verify-mysql.cjs",
    "db:sync": "node scripts/sync-mysql-to-supabase.cjs",
    "db:sync:dry-run": "node scripts/sync-mysql-to-supabase.cjs --dry-run",
    "test": "node --test tests/*.test.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "json-bigint": "1.0.0",
    "mysql2": "3.24.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "jsdom": "29.1.1"
  }
}
